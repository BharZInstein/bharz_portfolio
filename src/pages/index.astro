---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    title: "SaveMyNode – Inode Recovery Tool for UNIX Systems",
    description:
      "A recovery tool for BTRFS and XFS file systems that restores corrupted or deleted inodes with 92% accuracy.",
    tech: ["C", "Python", "BTRFS", "XFS", "Linux"],
    link: "https://github.com/BharZInstein",
    details: [
      "Parsed superblocks and inode tables for low-level data reconstruction",
      "Restored corrupted/deleted inodes on BTRFS and XFS file systems with 92% accuracy",
      "Selected for Smart India Hackathon 2024 National Round"
    ]
  },
  {
    title: "Fluz Pay – Transaction Management Service",
    description:
      "A backend service for secure transaction management with JWT authentication and full audit logging.",
    tech: ["FastAPI", "PostgreSQL", "Docker", "JWT"],
    link: "https://github.com/BharZInstein",
    details: [
      "Designed a FastAPI backend with JWT authentication and transaction logging",
      "Containerized the application with Docker for consistent deployment",
      "Implemented RESTful APIs with role-based access control"
    ]
  },
  {
    title: "CV Powered Motion Controller – Hands-Free Gaming",
    description:
      "A motion-controlled system that lets you play games using body gestures instead of a keyboard — running at 30 FPS in real-time.",
    tech: ["Python", "OpenCV", "MediaPipe"],
    link: "https://github.com/BharZInstein/CV-Powered-Motion-Controller",
    details: [
      "Built a computer-vision gesture recognition pipeline using OpenCV and MediaPipe at 30 FPS",
      "Mapped gestures to keyboard inputs for application and game control",
      "Aimed at making games more accessible and immersive"
    ]
  },
  {
    title: "Digisoul – Decentralized Financial Reputation System",
    description:
      "A DeFi protocol enabling under-collateralized lending using Soulbound Tokens and Zero-Knowledge Proofs.",
    tech: ["Solidity", "Hardhat", "ZKPs", "SBTs"],
    link: "https://devfolio.co/projects/digi-soul-a1e6",
    details: [
      "Verified user creditworthiness without exposing sensitive data",
      "Leveraged ZKPs for privacy and SBTs for on-chain identity",
      "Won 1st place at DeFy'25 Hackathon among 350+ participants"
    ]
  },
];

const experience = [
  {
    period: "Jun 2025 – Aug 2025",
    role: "Software Engineering Intern",
    company: "OrangePeople",
    companyUrl: "https://op.tech/",
    details: [
      "Developed and evaluated an NLP-based ML model converting natural-language queries into structured architecture diagrams (85% accuracy)",
      "Worked on data preprocessing, feature extraction, and error analysis in Python",
      "Integrated ML models into FastAPI services and deployed them on AWS"
    ]
  },
  {
    period: "May 2025 – Present",
    role: "Vice Chairperson",
    company: "CyberSecurity Student Community (CYSCOM), VITC",
    companyUrl: "https://www.linkedin.com/company/cyscomvit/posts/?feedView=all",
    details: [
      "Manages a 200+ member community, organizes workshops/CTFs, and mentors junior members",
      "Coordinates technical sessions and cybersecurity awareness events across campus"
    ]
  },
  {
    period: "2023 – Present",
    role: "Open Source Contributor",
    company: "Zen Browser & IEEE Computer Society, VITC",
    companyUrl: "https://ieeecsvitc.com/",
    details: [
      "Contributed features, bug fixes, and tests to Zen Browser",
      "Built event-registration CLI and note-sharing tools at IEEE VITC for 500+ students",
      "Co-led HACKHUB, a flagship GitHub-sponsored hackathon with 350+ participants"
    ]
  },
];

const education = [
  {
    institution: "Vellore Institute of Technology, Chennai",
    degree: "Bachelors in Technology (B.Tech)",
    period: "2023 – 2027",
  },
  {
    institution: "Indian Institute of Technology, Madras",
    degree: "Bachelor of Science in Data Science",
    period: "2023 – Present",
    coursework: "Data Structures & Algorithms, Operating Systems, Database Management Systems"
  },
];



---

<Layout title="Bharghav Srinivasan – Engineer & Developer" description="Personal portfolio of Bharghav Srinivasan – software engineer, open source contributor, and ML enthusiast from VIT Chennai & IIT Madras.">
    <div class="min-h-screen bg-black text-white w-full">
      <!-- Main Layout -->
      <div class="flex flex-col lg:flex-row min-h-screen">
        <!-- Left Content -->
        <div class="flex-1 p-8 lg:p-16 max-w-2xl order-2 lg:order-1">
          <!-- Header -->
          <header class="mb-16">
            <a href="#top" class="block mb-4 group">
              <h1 class="text-4xl lg:text-5xl font-bold font-serif group-hover:text-amber-400 transition-colors">
                Bharghav Srinivasan
              </h1>
            </a>
            <p class="text-gray-400 text-base font-mono">Engineer · Developer · Builder</p>
          </header>

          <!-- Navigation -->
          <nav class="mb-16">
            <div class="flex flex-wrap gap-6 text-lg">
              <a href="#about" class="hover:text-amber-400 transition-colors border-b border-gray-600">
                who am i
              </a>
              <a href="#experience" class="hover:text-amber-400 transition-colors">
                experience
              </a>
              <a href="#projects" class="hover:text-amber-400 transition-colors">
                projects
              </a>

            </div>
          </nav>

          <!-- About Section -->
          <section id="about" class="mb-12 space-y-6">
            <p class="text-lg text-gray-300 leading-relaxed">
              I'm a pre-final year undergrad from VIT Chennai who enjoys building things — whether it's something dumb, something useful, or something I just wanted to see work.
            </p>

            <p class="text-lg text-gray-300 leading-relaxed">
              What excites me most about tech is how you can start with just an idea and bring it to life using nothing but logic, math, and a bit of curiosity. I'm especially fascinated by machine learning — how deep learning lets machines learn patterns, make decisions, and in a way, "think" using layers of math.
            </p>

            <p class="text-lg text-gray-300 leading-relaxed">
              Over the years, I've built up experience across full-stack development and machine learning — working with tools like TypeScript, Next.js, Python, Flask, and libraries like TensorFlow and OpenCV. I've even explored blockchain and zero-knowledge cryptography for some of my more experimental builds.
            </p>

            <p class="text-lg text-gray-300 leading-relaxed">
              Outside of classes, I spend most of my time at hackathons, exploring new frameworks, or working with my college tech communities.
            </p>
          </section>

          <!-- Contact Links -->
          <div class="mb-12">
            <p class="text-gray-400 mb-4">Let's talk —</p>
            <div class="flex flex-wrap gap-6 text-amber-400">
              <a href="mailto:bharghav7676@gmail.com" class="hover:text-white transition-colors">
                Email
              </a>
              <a href="https://github.com/BharZInstein" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                GitHub
              </a>
              <a href="https://www.linkedin.com/in/bharghav-srinivasan/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                LinkedIn
              </a>
              <a href="https://x.com/bharzinstein76" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                Twitter
              </a>
            </div>
          </div>
        </div>

        <!-- Right Image: visible and centered on mobile, right on desktop -->
        <div class="flex justify-center items-center mb-8 lg:mb-0 flex-1 relative order-1 lg:order-2">
          <div class="w-40 h-40 sm:w-56 sm:h-56 lg:w-2/3 lg:h-2/3 flex items-center justify-center">
            <img
              src="/image.jpeg"
              alt="Bharghav Srinivasan"
              class="w-full h-full object-cover rounded-lg shadow-2xl"
            />
          </div>
        </div>
      </div>

      <!-- Education Section -->
      <section class="px-8 lg:px-16 py-16 max-w-6xl border-t border-gray-900">
        <h2 class="text-2xl lg:text-3xl font-bold font-serif mb-10 text-gray-300">Education</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {education.map((edu) => (
            <div class="border border-gray-800 rounded-lg p-6 hover:border-amber-400 transition-colors">
              <p class="text-amber-400 text-sm font-mono mb-2">{edu.period}</p>
              <h3 class="text-lg font-semibold font-serif mb-1">{edu.institution}</h3>
              <p class="text-gray-400 text-sm mb-2">{edu.degree}</p>
              {edu.coursework && (
                <p class="text-gray-600 text-xs">Coursework: {edu.coursework}</p>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Experience Section -->
      <section id="experience" class="px-8 lg:px-16 py-20 max-w-6xl">
        <h2 class="text-3xl lg:text-4xl font-bold font-serif mb-4">Experience</h2>
        <p class="text-gray-400 mb-16 text-lg">My professional journey</p>

        <div class="space-y-12">
          {experience.map((job) => (
            <div class="border-l-2 border-gray-800 pl-8 hover:border-amber-400 transition-colors">
              <div class="flex flex-wrap justify-between items-start mb-2 gap-2">
                <div>
                  <h3 class="text-xl font-semibold font-serif">{job.role}</h3>
                  <a href={job.companyUrl} target="_blank" rel="noopener noreferrer" class="text-amber-400 font-medium hover:text-white transition-colors">
                    {job.company}
                  </a>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-gray-500 text-sm">{job.period}</span>
                </div>
              </div>
              <div class="mb-4">
                {job.details.map((detail) => (
                  <p class="text-gray-400 text-sm mb-1">– {detail}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Projects Section -->
      <section id="projects" class="px-8 lg:px-16 py-20 max-w-6xl">
        <h2 class="text-3xl lg:text-4xl font-bold font-serif mb-4">Projects</h2>
        <p class="text-gray-400 mb-16 text-lg">Some things I've built</p>

        <div class="space-y-12">
          {projects.map((project) => (
            <div
              class="group border-b border-gray-800 pb-12 hover:border-gray-600 transition-colors cursor-pointer"
            >
              <div class="flex justify-between items-start mb-4">
                <h3 class="text-2xl font-semibold font-serif group-hover:text-amber-400 transition-colors">
                  {project.title}
                </h3>
                <div class="flex items-center gap-4">
                  <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-amber-400 transition-colors">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-all"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                      <polyline points="15,3 21,3 21,9"></polyline>
                      <line x1="10" y1="14" x2="21" y2="3"></line>
                    </svg>
                  </a>
                </div>
              </div>

              <p class="text-gray-300 leading-relaxed mb-4 font-serif">{project.description}</p>

              <div class="mb-6">
                {project.details.map((detail) => (
                  <p class="text-gray-400 text-sm mb-2">– {detail}</p>
                ))}
              </div>

              <div class="flex flex-wrap gap-3">
                {project.tech.map((tech) => (
                  <span class="text-xs text-gray-400 bg-gray-900 px-3 py-1 rounded-full">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>



      <!-- Footer -->
      <footer class="px-8 lg:px-16 py-12 border-t border-gray-800">
        <div class="flex justify-between items-center max-w-6xl">
          <p class="text-gray-500 text-sm">Made with ❤️ by Bharghav</p>
          <div class="flex gap-6">
            <a href="mailto:bharghav7676@gmail.com" class="text-gray-500 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </a>
            <a href="https://github.com/BharZInstein" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/bharghav-srinivasan/" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
          </div>
        </div>
      </footer>
    </div>
</Layout>